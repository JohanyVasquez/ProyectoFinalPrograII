# =====================================================================
# ParkEasy - variables de entorno
# ---------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores reales:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# `.env` está en `.gitignore`: NO lo subas nunca.
# =====================================================================

# URL del proyecto de Supabase.
# Dashboard > Connect > Project URL
# Formato: https://TU_PROJECT_REF.supabase.co   (sin barra final)
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Clave publicable (`sb_publishable_...`).
# Dashboard > Connect > App Frameworks > Expo
#
# OJO: esta clave SÍ viaja dentro del bundle de la app. No es un secreto y
# está pensada para ser pública. La protección de los datos la da RLS
# (las políticas de `supabase/migrations/001_initial_schema.sql`), no la clave.
#
# NUNCA pongas aquí la `service_role` ni la `secret`: con ellas se ignora RLS
# por completo y cualquier usuario podría leer/escribir toda la base de datos.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE